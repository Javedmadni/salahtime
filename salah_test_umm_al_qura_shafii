<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Salah Times Test – Umm al-Qura, Shafi'i</title>
<style>
*{box-sizing:border-box}body{margin:0;padding:20px 12px;background:#f4f4f9;font-family:'Segoe UI',Tahoma,Arial,sans-serif;text-align:center;color:#222}.container{max-width:450px;margin:auto;background:white;border-radius:10px;overflow:hidden;box-shadow:0 4px 15px #0002}.header{background:green;color:#ffd700;padding:22px 12px}.header h1{font-size:25px;margin:0}.contact{background:#e9ecef;padding:12px;font-size:14px}.contact p{margin:4px}.content{padding:22px 18px}h2{font-size:23px}.warning{font-size:12px;font-weight:bold;color:#c00}.location{background:#efffef;border:1px solid #b5dfb5;border-radius:8px;padding:13px;margin:15px 0}.location h3{color:green;font-size:16px;margin:0 0 8px}.date{background:#303846;color:white;padding:13px;border-radius:6px;font-weight:bold;margin-top:14px}.hijri{font-size:13px;color:#555;margin:12px 0}.times{width:100%;border-collapse:collapse;text-align:left}.times td{padding:13px 15px;border-bottom:1px solid #ddd;font-size:14px}.times tr:nth-child(odd){background:#f5f6f8}.times td:last-child{text-align:right;font-weight:bold}.note{color:#777;font-size:12px;line-height:1.6;margin-top:16px}.method{font-size:12px;color:#555;margin-top:16px}button{border:0;background:green;color:white;border-radius:7px;padding:11px 15px;font-weight:bold;cursor:pointer}#retry{display:none;margin:10px auto}.status{font-size:13px;color:#555}#error{color:#b00020}.test{background:#fff6d8;padding:8px;font-size:12px;font-weight:bold}
</style>
</head>
<body><div class="container">
<div class="header"><h1>KULLIYATUR RAASHIDAATIL ISLAMIYAH</h1></div>
<div class="contact"><p>MALVANI, MHADA, MALAD, MUMBAI.</p><p>Mobile: <b>+91 87791 22931</b></p></div>
<div class="test">TEST VERSION — UMM AL-QURA + SHAFI'I</div>
<div class="content"><h2>🕋 SALAH AND SUNRISE TIME</h2><p class="warning">PLEASE CONFIRM TIMES WITH YOUR LOCAL MOSQUE</p>
<div class="location"><h3>📍 YOUR CURRENT LOCATION</h3><div id="locationName">Requesting location...</div></div>
<div class="status" id="status">Please allow location access when asked.</div><div id="error" role="alert"></div><button id="retry" type="button">Allow Location / Try Again</button>
<div id="results" hidden><div class="date" id="date"></div><div class="hijri" id="hijri"></div><table class="times" aria-label="Prayer times"><tbody id="times"></tbody></table><div class="method" id="method"></div></div>
<div class="note">Prayer times: AlAdhan API • Umm al-Qura University, Makkah (method 4) • Shafi'i / Standard Asr (school 0).<br>Times are calculated for the detected coordinates. Local mosque times may differ.<br>جزاكم الله خيرا كثيرا</div>
</div></div>
<script>
'use strict';
const $=id=>document.getElementById(id);
const names=[['Fajr','Fajr'],['Sunrise','Sunrise'],['Dhuhr','Dhuhr'],['Asr','Asr'],['Maghrib','Maghrib'],['Isha','Isha']];
function formatTime(raw){const match=String(raw||'').match(/^(\d{1,2}):(\d{2})/);if(!match)return raw||'—';let h=Number(match[1]);return String(h%12||12).padStart(2,'0')+':'+match[2]+' '+(h>=12?'PM':'AM')}
function fail(message){$('status').textContent='';$('error').textContent=message;$('retry').style.display='inline-block'}
async function getCity(lat,lon){try{const u=new URL('https://nominatim.openstreetmap.org/reverse');u.searchParams.set('format','jsonv2');u.searchParams.set('lat',lat);u.searchParams.set('lon',lon);u.searchParams.set('zoom','10');const r=await fetch(u);if(!r.ok)throw Error('City lookup failed');const a=(await r.json()).address||{};const city=a.city||a.town||a.village||a.municipality||a.county||'';return [...new Set([city,a.state,a.country].filter(Boolean))].join(', ')}catch(e){return 'Location detected (city name unavailable)'}}
async function success(position){$('retry').style.display='none';$('error').textContent='';const lat=position.coords.latitude,lon=position.coords.longitude;$('locationName').textContent='Finding your city...';$('status').textContent='Loading prayer times...';getCity(lat,lon).then(city=>{$('locationName').textContent=city||'Location detected'});
try{const u=new URL('https://api.aladhan.com/v1/timings');u.searchParams.set('latitude',lat);u.searchParams.set('longitude',lon);u.searchParams.set('method','4');u.searchParams.set('school','0');const r=await fetch(u);if(!r.ok)throw Error('Prayer time service unavailable');const j=await r.json();if(j.code!==200||!j.data?.timings)throw Error('Invalid response');const d=j.data,t=d.timings;$('date').textContent=d.date?.readable||'Today';$('hijri').textContent=[d.date?.hijri?.day,d.date?.hijri?.month?.en,d.date?.hijri?.year,'AH'].filter(Boolean).join(' ');$('times').replaceChildren();for(const [key,label] of names){const tr=document.createElement('tr'),a=document.createElement('td'),b=document.createElement('td');a.textContent=label;b.textContent=formatTime(t[key]);tr.append(a,b);$('times').append(tr)}$('method').textContent='Calculation: Umm al-Qura University, Makkah • Shafi’i (Standard Asr) • Timezone: '+(d.meta?.timezone||'location local time');$('results').hidden=false;$('status').textContent='';}catch(e){fail('Unable to load prayer times. Check internet and tap Try Again.')}}
function requestLocation(){if(!navigator.geolocation){fail('This browser does not support location. Open the HTTPS website in Chrome or Edge.');return}$('retry').style.display='none';$('error').textContent='';$('status').textContent='Waiting for location permission...';navigator.geolocation.getCurrentPosition(success,e=>{const msg=e.code===1?'Location is blocked. Allow location in browser site permissions and try again.':e.code===2?'Location unavailable. Turn on phone location and try again.':'Location request timed out. Please try again.';fail(msg)},{enableHighAccuracy:false,timeout:18000,maximumAge:300000})}
$('retry').addEventListener('click',requestLocation);
requestLocation();
</script></body></html>
